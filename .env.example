# ── PostgreSQL ──────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=drplugg
PGUSER=drplugg
# Lämna tom – install.sh genererar ett slumpat lösenord (20 byte hex)
PGPASSWORD=

# ── Auth ────────────────────────────────────────────────────
# Lämna tom – install.sh genererar automatiskt (openssl rand -hex 32)
# Appen vägrar starta i produktion om värdet är kortare än 32 tecken eller innehåller "byt-mig"
JWT_SECRET=
# Er adminadress – install.sh vägrar köra om den är tom
ADMIN_EMAIL=
# Obligatoriskt vid första installationen – install.sh raderar raden efteråt.
ADMIN_PASSWORD=
# Sätts till true av enable-tls.sh (krävs över HTTPS)
COOKIE_SECURE=false
# Appens publika adress – används för omdirigeringar, metadata och länkar.
# Lämna tom: install.sh sätter http://<domän> och enable-tls.sh uppgraderar
# till https://<domän>. Utan värde blir omdirigeringar relativa (också korrekt).
PUBLIC_URL=

# ── Registrering ────────────────────────────────────────────
# false = registreringen är stängd; admin skapar konton under /admin
ALLOW_REGISTRATION=false

# ── E-post (valfritt) ───────────────────────────────────────
# Krävs bara om ni vill ha e-postverifiering eller "glömt lösenord" via mejl.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=
# SMTP_FROM_NAME=DrPlugg

# ── AI (Karolina) ───────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Repetition (FSRS) ───────────────────────────────────────
FSRS_RETENTION=0.9
# Valfritt: optimerade FSRS-vikter (19 komma-separerade tal)
# FSRS_W=
