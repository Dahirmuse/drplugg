# ── PostgreSQL ──────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=drplugg
PGUSER=drplugg
PGPASSWORD=byt-mig

# ── Auth ────────────────────────────────────────────────────
# Slumpa med: openssl rand -hex 32
JWT_SECRET=byt-mig-till-en-slumpad-hemlighet
# Admin-kontot som får rollen "admin" automatiskt
ADMIN_EMAIL=daahirmuse@gmail.com
# Sätts bara när du vill sätta/återställa admin-lösenordet vid migrering
# ADMIN_PASSWORD=valfritt-losenord
# Sätt false om du kör över plain http (t.ex. lokal LAN-IP)
COOKIE_SECURE=false

# ── AI ──────────────────────────────────────────────────────
DEEPSEEK_API_KEY=din_nyckel_har
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Repetition ──────────────────────────────────────────────
FSRS_RETENTION=0.9
# Valfritt: dina optimerade FSRS-vikter (19 tal, komma-separerade)
# FSRS_W=
